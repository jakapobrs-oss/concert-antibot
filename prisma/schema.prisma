// ============================================================
// Prisma Schema — Concert Anti-Bot System
// ============================================================
// Datasource: PostgreSQL 16 (BIGSERIAL primary keys ตามที่ user ขอ)
// Phase coverage:
//   Phase 2 ✅: User, Account, Session, VerificationToken
//   Phase 3 ✅: Concert, Zone, Seat, TicketType, Order, OrderItem
//   Phase 4-8 ⚪: QueueToken, SeatHold, Payment, BotEvent, AuditLog (จะเพิ่มใน phase ถัดไป)
//
// อ้างอิงเต็มที่ docs/04_ER_DIAGRAM.md
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // url = connection ผ่าน pooler (pgbouncer) — ใช้ตอน runtime serverless บน Vercel
  //   Neon: ใช้ host ที่มี "-pooler" (กัน connection ระเบิดเวลามีหลาย serverless instance)
  url       = env("DATABASE_URL")
  // directUrl = connection ตรง ไม่ผ่าน pooler — Prisma ใช้ตอน migrate deploy เท่านั้น
  //   Neon: ใช้ host ปกติ (ไม่มี -pooler). local docker: ตั้งให้เท่ากับ DATABASE_URL ได้
  directUrl = env("DIRECT_URL")
}

// ============================================================
// 1. AUTH (Phase 2) — รองรับ NextAuth v5 + Email/Password
// ============================================================

model User {
  id            BigInt    @id @default(autoincrement())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  phone         String?
  image         String?
  // argon2id hash — null ถ้า login ผ่าน Google เท่านั้น
  passwordHash  String?
  role          UserRole  @default(USER)
  // คะแนนความน่าเชื่อถือ ใช้ตัดสินใจ anti-bot escalation (0-100)
  trustScore    Int       @default(50)
  // กัน brute-force login
  failedLoginCount Int    @default(0)
  lockedUntil   DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  orders      Order[]
  queueTokens QueueToken[]
  tickets     Ticket[]
  // named ticket: รายการที่นั่งที่ user นี้ถูกตั้งเป็น "ผู้ถือ" (อาจซื้อโดยคนอื่น)
  heldItems     OrderItem[]    @relation("ItemHolder")
  // คำขอคืนบัตรที่เงินต้องคืนให้ user นี้ (ผู้ซื้อ)
  ticketReturns TicketReturn[] @relation("ReturnPayer")
  // ---- Phase 2 (สมาชิก) ----
  membership         Membership?
  // สมาชิกที่ user นี้ (แอดมิน) เป็นคนกดให้สิทธิ์ — audit ว่าใครให้ใคร
  grantedMemberships Membership[] @relation("MembershipGrantedBy")

  @@index([email])
  @@map("users")
}

enum UserRole {
  USER
  ADMIN
}

// NextAuth v5 — OAuth link (Google)
model Account {
  id                BigInt  @id @default(autoincrement())
  userId            BigInt
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           BigInt   @id @default(autoincrement())
  sessionToken String   @unique
  userId       BigInt
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================
// 2. CONCERT (Phase 3) — งานคอนเสิร์ต + zone + seat
// ============================================================

model Concert {
  id                  BigInt        @id @default(autoincrement())
  title               String        @db.VarChar(255)
  slug                String        @unique @db.VarChar(255)
  description         String        @db.Text
  coverImageUrl       String?       @db.VarChar(500)
  venue               String        @db.VarChar(255)
  eventAt             DateTime
  saleStartAt         DateTime
  saleEndAt           DateTime
  maxTicketsPerUser   Int           @default(4)
  // ---- Phase 2 (ผังจากรูป) ----
  // รูปผังสถานที่เก็บเป็น base64 (แพทเทิร์นเดียวกับ Payment.slipImageUrl — ไม่ได้ใช้ MinIO/S3)
  // ย่อฝั่ง client ก่อนส่งเสมอ (กว้าง ~1600px, webp) ไม่งั้นชน serverActions.bodySizeLimit = 3mb
  layoutImageBase64   String?       @db.Text
  // ขนาดรูปหลังย่อ (px) — จำเป็นเพราะพิกัดที่นั่งเก็บเป็น "สัดส่วน 0-1" ไม่ใช่พิกเซล
  // ต้องรู้ w/h ไว้ตั้ง viewBox ของ SVG ให้อัตราส่วนตรงรูป ไม่งั้นผังยืด/บี้ตอน render
  layoutImageWidth    Int?
  layoutImageHeight   Int?
  // กรอบเวทีที่แอดมินวาดทับรูป: [[x,y],[x,y],...] พิกัดสัดส่วน 0-1 เหมือน Zone.polygon
  // ต้องเก็บเป็นข้อมูล ไม่ใช่ปล่อยให้เวทีเป็นแค่ส่วนหนึ่งของรูป เพราะระบบต้องใช้ตอบว่า
  // "โซนนี้อยู่ตรงไหนเทียบกับเวที" (เรียงโซนตามระยะห่างจากเวที + ปักป้ายเวทีบนผัง)
  // null = คอนเสิร์ตที่ยังไม่ได้ระบุเวที -> ผังยังใช้ได้ แค่ไม่มีป้ายเวที
  stagePolygon        Json?
  status              ConcertStatus @default(DRAFT)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  zones       Zone[]
  orders      Order[]
  queueTokens QueueToken[]
  saleRounds  SaleRound[]

  @@index([slug])
  @@index([status, saleStartAt])
  @@map("concerts")
}

enum ConcertStatus {
  DRAFT       // กำลังเตรียม
  SCHEDULED   // ตั้งเวลาขายแล้ว
  ON_SALE     // กำลังขาย
  SOLD_OUT    // ขายหมด
  ENDED       // จบงานแล้ว
}

model Zone {
  id          BigInt  @id @default(autoincrement())
  concertId   BigInt
  name        String  @db.VarChar(50) // VIP, R1, R2
  description String? @db.VarChar(255)
  price       Decimal @db.Decimal(10, 2) // THB
  totalSeats  Int
  color       String  @default("#ef4444") @db.VarChar(7) // สีบน seat map
  // ชื่อเรทราคาที่โซนนี้สังกัด (มาจากไฟล์ Excel ที่แอดมินนำเข้า) เช่น "เรท 1", "VIP"
  // ใช้ทำคำอธิบายสี (legend) ฝั่งคนซื้อ: หลายโซนที่เรทเดียวกันยุบเหลือบรรทัดเดียว
  // null = โซนที่สร้างมือก่อนมีระบบนำเข้า -> legend จะใช้ราคาเป็นชื่อแทน
  tier        String? @db.VarChar(50)
  // ---- Phase 2 (ผังจากรูป) ----
  // กรอบโซนที่แอดมินคลิกวาดทับรูป: [[x,y],[x,y],...] พิกัดเป็นสัดส่วน 0-1 ของขนาดรูป
  // null = โซนแบบเดิม (ไม่มีผังเชิงพื้นที่) -> ฝั่งคนซื้อ fallback ไป seat-map ปุ่มแบบเก่า
  polygon     Json?

  concert Concert @relation(fields: [concertId], references: [id], onDelete: Cascade)
  seats   Seat[]

  @@index([concertId])
  @@map("zones")
}

model Seat {
  id         BigInt     @id @default(autoincrement())
  zoneId     BigInt
  rowLabel   String     @db.VarChar(10) // A, B, C...
  seatNumber Int
  status     SeatStatus @default(AVAILABLE)
  // ---- Phase 2 (ผังจากรูป) ----
  // พิกัดบนผัง เป็น "สัดส่วน 0-1" ของขนาดรูป (ไม่ใช่พิกเซล) — เปิดคนละจอ/รูปคนละขนาดก็ไม่เพี้ยน
  // null = ที่นั่งที่เจนมาก่อนมีระบบผัง (คอนเสิร์ตเก่า) — ยังใช้งานได้ปกติ
  x          Float?
  y          Float?
  createdAt  DateTime   @default(now())

  zone       Zone        @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  orderItem  OrderItem?
  // 1 ที่นั่งมีได้หลายตั๋ว "ในประวัติ" (ตั๋วที่ถูกคืนแล้ว + ตั๋วปัจจุบัน) — ตั๋ว active
  // ถูกบังคับใบเดียวด้วย partial unique index (WHERE returnedAt IS NULL) ใน migration
  tickets    Ticket[]

  @@unique([zoneId, rowLabel, seatNumber])
  @@index([zoneId, status])
  @@map("seats")
}

enum SeatStatus {
  AVAILABLE
  HELD      // มี hold (Redis lock) — sync มาที่นี่ตอน confirm
  SOLD
  BLOCKED   // admin ปิดที่นั่งนี้
}

// ============================================================
// 3. ORDER (Phase 3) — minimal version; Payment จะเพิ่ม Phase 7
// ============================================================

model Order {
  id          BigInt      @id @default(autoincrement())
  userId      BigInt
  concertId   BigInt
  totalAmount Decimal     @db.Decimal(10, 2)
  currency    String      @default("THB") @db.VarChar(3)
  status      OrderStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  paidAt      DateTime?
  expiresAt   DateTime    // ถ้า pending เกินเวลานี้ → cancel auto
  // ---- Phase 2 (รอบขาย) ----
  // รอบที่ order นี้เกิด — เก็บไว้ audit/สถิติในเล่ม (แยกยอดรอบสมาชิก vs รอบทั่วไป)
  // ⚠️ ไม่มี logic ไหนอ่าน field นี้ตัดสินใจ — เพดานตั๋วยังนับ "รวมทุกรอบ" ต่อคอนเสิร์ตเหมือนเดิม
  saleRoundId BigInt?

  user      User       @relation(fields: [userId], references: [id])
  concert   Concert    @relation(fields: [concertId], references: [id])
  saleRound SaleRound? @relation(fields: [saleRoundId], references: [id], onDelete: SetNull)
  items   OrderItem[]
  payment Payment?
  tickets Ticket[]

  @@index([userId, status])
  @@index([status, expiresAt])
  @@index([saleRoundId])
  @@map("orders")
}

enum OrderStatus {
  PENDING     // รอจ่ายเงิน
  PAID        // จ่ายแล้ว ออกตั๋วแล้ว
  CANCELLED   // ยกเลิก / timeout
  REFUNDED    // คืนเงิน
}

model OrderItem {
  id      BigInt  @id @default(autoincrement())
  orderId BigInt
  seatId  BigInt  @unique // 1 ที่นั่ง 1 order item
  price   Decimal @db.Decimal(10, 2) // snapshot ราคา
  // named ticket: ผู้ถือบัตรของที่นั่งนี้ — commit ตอน checkout ก่อนจ่าย แก้ไม่ได้หลังจ่าย
  // null = ยังไม่ระบุ (default ตอนออกตั๋ว = ผู้ซื้อ)
  holderUserId BigInt?

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seat   Seat  @relation(fields: [seatId], references: [id])
  holder User? @relation("ItemHolder", fields: [holderUserId], references: [id])

  @@index([orderId])
  @@index([holderUserId])
  @@map("order_items")
}

// ============================================================
// 7. PAYMENT + TICKET (Phase 7)
// ============================================================
// Payment — บันทึกการชำระเงิน (PromptPay + EasySlip verify)
model Payment {
  id          BigInt        @id @default(autoincrement())
  orderId     BigInt        @unique // 1 order 1 payment
  method      PaymentMethod @default(PROMPTPAY)
  amount      Decimal       @db.Decimal(10, 2)
  currency    String        @default("THB") @db.VarChar(3)
  status      PaymentStatus @default(PENDING)
  // ref จาก slip (transaction id ของธนาคาร) — UNIQUE กันใช้สลิปซ้ำ
  slipRef     String?       @unique @db.VarChar(255)
  slipImageUrl String?      @db.VarChar(500) // เก็บใน MinIO
  senderName  String?       @db.VarChar(255) // ชื่อผู้โอน (จาก EasySlip)
  // เลขบัญชี/พร็อกซีผู้จ่าย (จาก EasySlip — มัก masked เช่น xxx-x-x1234-5)
  senderAccount String?     @db.VarChar(255)
  // คีย์ผู้จ่ายที่ normalize แล้ว (acct:<เลข> หรือ name:<ชื่อ>) — ใช้ทำ "per-payer cap"
  //   กันขบวนการบอทปั๊มหลาย account แต่จ่ายจากบัญชีธนาคารเดียว (ชั้นที่ปลอมไม่ได้ = โอนเงินจริง)
  payerKey    String?       @db.VarChar(255)
  paidAt      DateTime?
  createdAt   DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([payerKey]) // เร่ง query นับตั๋วต่อผู้จ่าย
  @@map("payments")
}

enum PaymentMethod {
  PROMPTPAY
  OMISE // optional future (card/truemoney)
}

enum PaymentStatus {
  PENDING   // รอโอน + upload สลิป
  VERIFYING // กำลัง verify สลิป
  SUCCESS   // ยืนยันแล้ว เงินเข้า
  FAILED    // สลิปผิด / ยอดไม่ตรง
  // Codex #3: เงินเข้าจริง (สลิปผ่าน verify) แต่ออกตั๋วไม่ได้ (order ตาย/ที่นั่งหลุด/ชน payer cap)
  // → ทีมงานต้องคืนเงินด้วยมือ — เก็บใน DB ให้ตามได้ ไม่ใช่แค่ console log
  REFUND_REQUIRED
  REFUNDED // ทีมงานโอนเงินคืนแล้ว (admin กดยืนยันจากหน้า refunds)
}

// Ticket — ตั๋วที่ออกหลังจ่ายเงินสำเร็จ
// named ticket: userId = "ผู้ถือ" (holder — default คือผู้ซื้อ), Order.userId = ผู้ซื้อ (payer)
model Ticket {
  id       BigInt   @id @default(autoincrement())
  orderId  BigInt
  // ⚠️ unique เฉพาะตั๋วที่ยังไม่ถูกคืน — partial unique index "tickets_seatId_active_key"
  //    (WHERE returnedAt IS NULL) สร้างใน migration เพราะ Prisma ไม่รองรับ partial index ใน schema
  seatId   BigInt
  userId   BigInt
  qrCode   String   @unique @db.VarChar(255) // legacy static QR (Phase 3 เปลี่ยนเป็น dynamic แล้ว)
  price    Decimal  @db.Decimal(10, 2)
  issuedAt DateTime @default(now())
  // snapshot ชื่อผู้ถือ ณ ตอนออกตั๋ว — จนท.หน้างานใช้เทียบบัตรประชาชน (ชื่อบนบัตรแก้ไม่ได้)
  holderName  String   @default("")
  // check-in กันใช้ซ้ำ: 1 บัตรสแกนเข้าได้ครั้งเดียว
  checkedInAt DateTime?
  // secret สำหรับ dynamic QR (HMAC หมุนตามเวลา) — ห้ามส่งไป client เด็ดขาด
  qrSecret    String   @default("")
  // คืนบัตรเข้าระบบแล้ว (ที่นั่งกลับเข้า pool) — ตั๋วใบนี้ใช้เข้างานไม่ได้อีก
  returnedAt  DateTime?

  order  Order         @relation(fields: [orderId], references: [id])
  seat   Seat          @relation(fields: [seatId], references: [id])
  user   User          @relation(fields: [userId], references: [id])
  return TicketReturn?

  @@index([userId])
  @@index([orderId])
  @@index([seatId])
  @@map("tickets")
}

// คำขอคืนบัตร — ที่นั่งกลับเข้า pool ขายผ่านคิวปกติ, เงินคืน "ราคาหน้าบัตร" ให้ผู้ซื้อเดิม
// (ตั้งใจไม่ให้เลือกผู้รับบัตรตอนคืน — กันเป็นช่อง resale/โอนอำพราง ตามกฎเหล็ก docs/19)
model TicketReturn {
  id           BigInt       @id @default(autoincrement())
  ticketId     BigInt       @unique
  orderId      BigInt
  payerUserId  BigInt // ผู้ซื้อ — เงินคืนไปหาคนนี้
  holderUserId BigInt? // ผู้ถือ ณ ตอนคืน (audit)
  amount       Decimal      @db.Decimal(10, 2) // ราคาหน้าบัตร (จาก Ticket.price)
  seatLabel    String // snapshot "โซน/แถว/เลขที่นั่ง" ไว้ดูย้อนหลังหลัง OrderItem ถูกลบ
  status       RefundStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  refundedAt   DateTime?

  ticket Ticket @relation(fields: [ticketId], references: [id])
  payer  User   @relation("ReturnPayer", fields: [payerUserId], references: [id])

  @@index([status])
  @@map("ticket_returns")
}

enum RefundStatus {
  PENDING  // รอทีมงานโอนเงินคืน
  REFUNDED // คืนเงินแล้ว (admin กดยืนยัน)
}

// ============================================================
// 4. QUEUE (Phase 4) — Virtual Waiting Room (audit record)
// ============================================================
// ⚠️ กลไกคิวจริง (ลำดับ + การปล่อย batch) อยู่ใน Redis (เร็ว + atomic)
//    ตารางนี้เก็บ audit/snapshot เพื่อ:
//      - วิเคราะห์ความเป็นธรรมใน thesis (เก็บ enteredAt + randomScore)
//      - กู้คืนถ้า Redis หาย
//      - ตรวจสอบย้อนหลังว่าใครเข้าคิวเมื่อไหร่ ได้ token อะไร
model QueueToken {
  id              BigInt           @id @default(autoincrement())
  token           String           @unique @db.VarChar(64) // secure random — client ถือไว้
  concertId       BigInt
  userId          BigInt?          // null ได้ถ้ายังไม่ login (กันคิวด้วย fingerprint)
  fingerprintHash String?          @db.VarChar(64) // ผูกกับ device กัน 1 คนถือหลาย slot
  ip              String?          @db.VarChar(45)
  // fairness fields — เก็บไว้พิสูจน์ว่าไม่ลำเอียงใน thesis
  timeBucket      BigInt           // window ที่เข้าคิว (epoch ms / bucketSize) — คนใน bucket เดียวกันเสมอภาค
  randomScore     Int              // 0-999999 สุ่มภายใน bucket → ตัดสินลำดับแบบสุ่ม ไม่เอาความเร็วระดับ ms
  status          QueueTokenStatus @default(WAITING)
  position        Int? // ตำแหน่งล่าสุดที่ snapshot (อาจ stale — ดู Redis สำหรับ real-time)
  enteredAt       DateTime         @default(now())
  admittedAt      DateTime? // เวลาที่ถูกปล่อยเข้าห้องเลือกที่นั่ง
  expiresAt       DateTime // TTL ของ admit window

  concert Concert @relation(fields: [concertId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([concertId, status])
  @@index([token])
  @@map("queue_tokens")
}

enum QueueTokenStatus {
  WAITING   // อยู่ในห้องรอ
  ADMITTED  // ถูกปล่อยให้เข้าเลือกที่นั่งแล้ว
  EXPIRED   // หมดเวลา admit ไม่ทันใช้
  CONVERTED // ใช้ token แล้ว (ไปจองสำเร็จ)
  LEFT      // ออกจากคิวเอง
}

// ============================================================
// 5. ANTI-BOT (Phase 5-6) — บันทึกทุกการตรวจจับเพื่อ dashboard + thesis
// ============================================================
// เก็บทุกครั้งที่ระบบประเมิน bot score (ก่อนเข้าคิว) — ใช้:
//   - admin ดู dashboard ว่ามีบอทมากแค่ไหน (Phase 8)
//   - thesis วิเคราะห์ false positive rate / สัดส่วน bot vs human
//   - audit ย้อนหลังว่าทำไม request ถูก block/challenge
model BotEvent {
  id              BigInt        @id @default(autoincrement())
  userId          BigInt?       // null ถ้ายังไม่ login
  ip              String?       @db.VarChar(45)
  userAgent       String?       @db.VarChar(500)
  fingerprintHash String?       @db.VarChar(64)
  // คะแนน 0-100 (ยิ่งสูงยิ่งน่าจะเป็นบอท) — รวมจากทุกสัญญาณ
  score           Int
  // ผลการตัดสินใจ
  action          BotAction
  // signals ที่ fire (เก็บเป็น JSON: { "turnstile": "pass", "ua": "suspicious", ... })
  signals         Json
  // จุดที่ตรวจ (queue_join / seat_select / ...) — ขยายได้
  checkpoint      String        @default("queue_join") @db.VarChar(50)
  createdAt       DateTime      @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@map("bot_events")
}

enum BotAction {
  ALLOW     // ผ่าน — score ต่ำ
  CHALLENGE // ให้ทำ CAPTCHA/ยืนยันเพิ่ม — score กลาง (กัน false positive)
  BLOCK     // ปฏิเสธ — score สูงมาก
}

// ============================================================
// 6. BEHAVIOR (Phase 6) — Layer 2: วิเคราะห์พฤติกรรมจริง
// ============================================================
// เก็บ feature ที่สรุปจาก raw behavior events (mouse/key/scroll) ฝั่ง client
// ใช้:
//   - จับบอทที่ผ่าน Turnstile/UA check ได้ (บอทขยับเมาส์เป็นเส้นตรง, timing สม่ำเสมอ)
//   - เก็บ dataset ไป train ML / วิเคราะห์ใน thesis (human vs bot behavior)
// หมายเหตุ: เก็บ "feature สรุป" ไม่ใช่ raw ทุก pixel (privacy + ประหยัด storage)
model BehaviorSession {
  id                  BigInt   @id @default(autoincrement())
  sessionKey          String   @unique @db.VarChar(64) // ผูกกับ queue session ฝั่ง client
  userId              BigInt?
  // ----- features ที่คำนวณฝั่ง client -----
  mouseMoveCount      Int      @default(0) // จำนวนครั้งขยับเมาส์
  keyPressCount       Int      @default(0)
  // ความแปรปรวนของ timing ระหว่าง event (ms) — มนุษย์ไม่สม่ำเสมอ, บอทสม่ำเสมอ → variance ต่ำ
  mouseTimingVariance Float    @default(0)
  // entropy ของทิศทางการเคลื่อนเมาส์ (0=เส้นตรงล้วน/บอท, สูง=สุ่มแบบมนุษย์)
  mousePathEntropy    Float    @default(0)
  // เวลารวมที่อยู่บนหน้า (ms) — บอทมักเร็วผิดมนุษย์
  dwellTimeMs         Int      @default(0)
  // คะแนน behavior 0-100 (สูง = น่าจะบอท) คำนวณจาก features ข้างบน
  behaviorScore       Int      @default(0)
  isLikelyBot         Boolean  @default(false)
  createdAt           DateTime @default(now())

  @@index([sessionKey])
  @@index([createdAt])
  @@map("behavior_sessions")
}

// ============================================================
// 8. MEMBERSHIP (Phase 2) — สมาชิก ชั้นเดียว (เป็น/ไม่เป็น)
// ============================================================
// สิทธิ์เดียวที่สมาชิกได้ = "เข้ารอบขายก่อน" (ดู SaleRound.audience = MEMBER_ONLY)
//   - ห้ามให้ซื้อได้เยอะกว่าคนทั่วไป — จะขัดกับระบบกันคนกวาดตั๋ว (named ticket / ticket-limit)
//   - ไม่มีส่วนลดราคา — ไม่แตะ logic คิดเงินเลย
// 1 user มีได้ 1 แถว (ต่ออายุ = อัปเดตแถวเดิม ไม่สร้างแถวใหม่) -> query ง่าย ไม่ต้อง dedup
model Membership {
  id              BigInt           @id @default(autoincrement())
  userId          BigInt           @unique
  status          MembershipStatus @default(ACTIVE)
  source          MembershipSource @default(SELF_SIGNUP)
  startedAt       DateTime         @default(now())
  // 🔑 หมดอายุคำนวณสดจากเวลาปัจจุบัน ไม่ต้องมี cron มาพลิก status
  //    getActiveMembership() = status ACTIVE && (expiresAt = null || expiresAt > now)
  //    (ถ้าเก็บเป็น status EXPIRED จะเกิดบั๊กคลาสสิก: หมดอายุแล้วแต่ status ยัง ACTIVE เพราะ cron ไม่วิ่ง)
  expiresAt       DateTime?
  // แอดมินที่กดให้สิทธิ์ — null ถ้าสมัครเอง
  grantedByUserId BigInt?
  revokedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("MembershipGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@map("memberships")
}

enum MembershipStatus {
  ACTIVE
  REVOKED // แอดมินเพิกถอนสิทธิ์ (ต่างจาก "หมดอายุ" ที่ดูจาก expiresAt)
}

enum MembershipSource {
  SELF_SIGNUP // ผู้ใช้กดสมัครเอง (ฟรี)
  ADMIN_GRANT // แอดมินให้สิทธิ์
}

// ============================================================
// 9. SALE ROUND (Phase 2) — รอบกดบัตร ("สมาชิกกดก่อน")
// ============================================================
// 🔑 ดีไซน์ที่ปกป้องผลวิจัยในเล่ม:
//    "สมาชิกกดก่อน" ทำเป็น *รอบเวลาแยก* ไม่ใช่ให้แซงคิวในรอบเดียวกัน
//    -> คิวในแต่ละรอบยังเป็น FIFO เป็นธรรมเหมือนเดิม -> สถิติ fairness/inversion ในเล่มยังใช้ได้
//    (ถ้าทำเป็น priority แซงคิว ต้องรื้อบททดสอบทั้งบท — ห้ามทำ)
//
// กติกาการบังคับใช้ (ฝั่ง logic — lib/sale-round.ts):
//    - Concert.status = ON_SALE ยังเป็นสวิตช์หลักเหมือนเดิม รอบเป็นด่าน "ซ้อนทับ" ไม่ใช่มาแทน
//    - คอนเสิร์ตที่ไม่มีรอบเลย (0 แถว) = พฤติกรรมเดิมทุกอย่าง -> คอนเสิร์ตเก่าไม่พัง
//    - ผ่านได้เมื่อ: มีรอบที่ now อยู่ใน [startAt, endAt) และ (audience = PUBLIC หรือ user เป็นสมาชิก active)
//    - รอบสมาชิกปกติจะจบตรงเวลาที่รอบ PUBLIC เริ่ม (เช่น 19:00-19:30 แล้ว 19:30 เปิดทุกคน)
model SaleRound {
  id        BigInt            @id @default(autoincrement())
  concertId BigInt
  name      String            @db.VarChar(100) // "รอบสมาชิก", "รอบทั่วไป"
  audience  SaleRoundAudience @default(PUBLIC)
  startAt   DateTime
  endAt     DateTime
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  concert Concert @relation(fields: [concertId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@index([concertId, startAt])
  @@map("sale_rounds")
}

enum SaleRoundAudience {
  MEMBER_ONLY // เฉพาะสมาชิกที่ยัง active
  PUBLIC      // ทุกคน (สมาชิกก็เข้าได้)
}
